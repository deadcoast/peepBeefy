{
  "_meta": {
    "contract_name": "peepBeefy Source of Truth Registry",
    "contract_id": "peepbeefy.contract",
    "contract_version": "0.0.3",
    "generated_utc": "2026-02-20T04:22:27Z",
    "purpose": [
      "Machine-readable invariants + acceptance checks derived from chat decisions.",
      "Used by CI/dev tools and by the app itself to detect drift (missing commands, wrong defaults, removed launchers)."
    ],
    "non_goals": [
      "Not a replacement for prose docs (ASOT.md); this registry stays compact and testable.",
      "Not a list of every process; it defines behavior and UX guarantees."
    ]
  },
  "repo_layout_expectations": {
    "docs_root": "docs",
    "asot_dir": "docs/absolute-source-of-truth",
    "primary_entrypoint": "src/main.py",
    "assets": {
      "ascii_logo": "src/assets/ASCII-Collapsed-Logo.txt"
    },
    "launchers": {
      "cmd_shims": [
        "beefy.cmd",
        "peepBeefy.cmd"
      ],
      "double_click": [
        "RUN_peepBeefy.bat"
      ]
    }
  },
  "experience_layers": {
    "CLI01_dev_spec": {
      "role": "Operational source-of-truth for logic + introspection; stable anchor for correctness.",
      "audience": "Developers / power users / debugging",
      "must_exist": true
    },
    "CLI02_peepBeefy_shell": {
      "role": "Human-friendly command scheme runnable directly from shell; bridges novices to advanced usage.",
      "audience": "Gamers who can type short commands",
      "must_exist": true
    },
    "CLI03_interactive_default": {
      "role": "Interactive menu-driven default entry; teaches CLI02 commands via repeated exposure.",
      "audience": "Gamers opening a terminal for the first time",
      "must_exist": true
    }
  },
  "command_contract": {
    "brand_vocabulary": {
      "primary_entry": "beefy",
      "primary_verb": "peep",
      "tone": "gamer-friendly; avoids dev flag-soup in primary path",
      "notes": [
        "Interactive UI must show the same CLI02 commands as selectable options to teach progression."
      ]
    },
    "required_commands": [
      {
        "id": "CMD00",
        "layer": "CLI03",
        "command": "beefy",
        "expects": {
          "default_mode": "interactive"
        }
      },
      {
        "id": "CMD10",
        "layer": "CLI02",
        "command": "beefy peep all",
        "expects": {
          "outputs": [
            "heavy_process_table"
          ]
        }
      },
      {
        "id": "CMD11",
        "layer": "CLI02",
