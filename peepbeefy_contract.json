  },
  "invariants": [
    {
      "id": "INV01",
      "title": "Interactive is the default entry experience",
      "must": true,
      "why": "Primary audience is gamers/non-devs; typing long commands is a barrier.",
      "origin_tags": [
        "REQ01",
        "CLI03",
        "TSN01"
      ]
    },
    {
      "id": "INV02",
      "title": "Progression path is taught via command mirroring",
      "must": true,
      "why": "Interactive menu must show CLI02 commands so users learn them organically.",
      "origin_tags": [
        "CLI02",
        "CLI03",
        "TSH01"
      ]
    },
    {
      "id": "INV03",
      "title": "Discovery mode is resource-driven",
      "must": true,
      "why": "Users don't know what's normal; tool must surface what is actually heavy now.",
      "origin_tags": [
        "REQ01"
      ]
    },
    {
      "id": "INV04",
      "title": "Service-backed processes must be explainable",
      "must": true,
      "why": "Windows 11 runs many 'invisible' services; tool must map PIDs to services when possible.",
      "origin_tags": [
        "REQ01"
      ]
    },
    {
      "id": "INV05",
      "title": "Default output is legible and not metric-spam",
      "must": true,
      "why": "Rookie users need color/hierarchy and a small number of key columns.",
      "origin_tags": [
        "REQ02"
      ]
    },
    {
      "id": "INV06",
      "title": "Baseline snapshot + diff exists",
      "must": true,
      "why": "Catches 'what started itself' without requiring prior knowledge.",
      "origin_tags": [
        "REQ01"
      ]
    },
    {
      "id": "INV07",
      "title": "Visibility-first phase: no termination in primary flow",
      "must": true,
      "why": "Killing processes needs guardrails; current phase is discovery/clarity.",
      "origin_tags": [
        "SHELVED_FEATURES"
      ]
    },
    {
      "id": "INV08",
      "title": "Launch ergonomics: a no-typing option exists",
      "must": true,
      "why": "Terminal friction is real; double-click launcher or equivalent is required.",
      "origin_tags": [
        "REQ01"
      ]
    }
  ],
  "output_contract": {
    "rendering": {
      "library": [
        "rich",
        "typer"
      ],
      "must_use_color_coding": true,
      "must_avoid_overwhelming_density_by_default": true
    },
    "views": {
      "heavy_process_table": {
        "default_limit": 25,
        "required_fields": [
          "pid",
          "name",
          "cpu_percent",
          "ram_bytes"
        ],
        "recommended_fields": [
          "disk_read_bps",
          "disk_write_bps",
          "type",
          "service_names",
          "tags",
          "beef_score"
        ]
      },
      "process_detail_view": {
        "required_fields": [
          "pid",
          "name",
          "exe_path",
          "cmdline",
          "parent_pid",
          "username"
        ],
        "recommended_fields": [
          "service_names",
          "tags",
          "cpu_sample",
          "io_sample",
          "ram_bytes"
        ]
      },
      "process_diff_table": {
        "required_fields": [
          "change_type",
          "name",
          "pid",
          "exe_path"
        ],
        "recommended_fields": [
          "tags",
          "service_names"
        ]
      }
    }
  },
